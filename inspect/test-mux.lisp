;;;; test-mux.lisp — demux a vector, remux its frames with our muxer, check that
;;;; (a) ffprobe accepts the result, (b) our demuxer reads back identical frames
;;;; and timestamps, and (c) ffmpeg decodes the remuxed file to the same pixels
;;;; as the original.
;;;;   run:  sbcl --non-interactive --load inspect/test-mux.lisp
(require :asdf)
(push (truename "./") asdf:*central-registry*)
(handler-case (asdf:load-system :webm-pure)
  (error (e) (format t "~&LOAD-ERR ~a~%" e) (sb-ext:exit :code 1)))

(defun sh (fmt &rest args)
  (let ((cmd (apply #'format nil fmt args)))
    (multiple-value-bind (out err code)
        (uiop:run-program cmd :output :string :error-output :string :ignore-error-status t)
      (declare (ignore err))
      (values (string-trim '(#\Newline #\Space) out) code))))

(defun remux (in out)
  (let* ((bytes (webm-pure::slurp-file in))
         (w (webm-pure:parse-webm bytes))
         (scale (webm-pure:webm-timecode-scale w))
         (mx (webm-pure:make-muxer :timecode-scale scale))
         (map (make-hash-table)))
    (dolist (tr (webm-pure:webm-tracks w))
      (setf (gethash (webm-pure:track-number tr) map)
            (case (webm-pure:track-type tr)
              (1 (webm-pure:add-video-track mx :codec-id (webm-pure:track-codec-id tr)
                                            :width (webm-pure:track-width tr) :height (webm-pure:track-height tr)
                                            :frame-rate (and (webm-pure:track-default-duration tr)
                                                             (/ 1d9 (webm-pure:track-default-duration tr)))))
              (2 (webm-pure:add-audio-track mx :codec-id (webm-pure:track-codec-id tr)
                                            :sample-rate (webm-pure:track-sample-rate tr)
                                            :channels (webm-pure:track-channels tr)
                                            :codec-private (webm-pure:track-codec-private tr)
                                            :codec-delay (webm-pure:track-codec-delay tr)
                                            :seek-pre-roll (webm-pure:track-seek-pre-roll tr))))))
    (let ((n 0))
      (webm-pure:map-frames
       (lambda (f)
         (let ((tn (gethash (webm-pure:track-number (webm-pure:frame-track f)) map)))
           (when tn
             (incf n)
             (webm-pure:add-frame mx tn (* (webm-pure:frame-timecode f) scale) (webm-pure:frame-data f)
                                  :keyframe (webm-pure:frame-keyframe-p f)
                                  :discard-padding (webm-pure:frame-discard-padding f)))))
       w)
      (webm-pure:write-webm-file mx out)
      (values n (webm-pure:collect-frames w)))))

(defun frames-equal-p (a b)
  (and (= (length a) (length b))
       (every (lambda (x y)
                (and (= (webm-pure:frame-timecode x) (webm-pure:frame-timecode y))
                     (eq (webm-pure:frame-keyframe-p x) (webm-pure:frame-keyframe-p y))
                     (= (webm-pure:track-type (webm-pure:frame-track x))
                        (webm-pure:track-type (webm-pure:frame-track y)))
                     (equalp (webm-pure:frame-data x) (webm-pure:frame-data y))))
              a b)))

(let ((ok t))
  (dolist (name '("t1-basic" "t5-av" "t2-altref"))
    (let* ((in (format nil "vectors/~a.webm" name))
           (out (format nil "/tmp/~a-remux.webm" name)))
      (handler-case
          (multiple-value-bind (n orig) (remux in out)
            (let* ((back (webm-pure:collect-frames (webm-pure:parse-webm (webm-pure::slurp-file out))))
                   (same (frames-equal-p orig back))
                   (probe (sh "ffprobe -v error -show_entries stream=codec_name -of csv=p=0 ~a" out))
                   (md5-in (sh "ffmpeg -v error -i ~a -map 0 -f md5 - 2>/dev/null" in))
                   (md5-out (sh "ffmpeg -v error -i ~a -map 0 -f md5 - 2>/dev/null" out)))
              (format t "~&~10a frames=~3d roundtrip=~a ffprobe=[~a] decode-md5-equal=~a~%"
                      name n (if same "SAME" "DIFFERENT") (substitute #\Space #\Newline probe)
                      (if (string= md5-in md5-out) "YES" (format nil "NO (~a vs ~a)" md5-in md5-out)))
              (unless (and same (string= md5-in md5-out)) (setf ok nil))))
        (error (e) (format t "~&~a: ERROR ~a~%" name e) (setf ok nil)))))
  (format t "~&~a~%" (if ok "MUX ROUNDTRIP OK" "MUX PROBLEMS"))
  (sb-ext:exit :code (if ok 0 1)))
